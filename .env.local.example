# Backend service URLs — server-side only, used by Next.js proxy routes.
# Never prefix these with NEXT_PUBLIC_ — that would expose them in the browser bundle.
# Set these in the Vercel dashboard (Settings → Environment Variables) for production.
INGEST_GATE_URL=http://localhost:8000
QUERY_SERVICE_URL=http://localhost:8002

# Optional: frontend base URL used to construct the OAuth callback redirect
# Set this as the FRONTEND_CALLBACK_URL on the backend too.
NEXT_PUBLIC_APP_URL=http://localhost:3000
